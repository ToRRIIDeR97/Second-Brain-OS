# Copy to .env.local (git-ignored) and fill in a Google Cloud "Desktop app" OAuth client
# to show a one-click "Sign in with Google" button on the Calendar page.
# Both values are compiled into the main process at build time; leave them empty to
# keep the paste-your-own-client form.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
