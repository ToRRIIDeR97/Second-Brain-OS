{
  "name": "second-brain-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd opencode dev:desktop",
    "desktop:dev": "bun run --cwd opencode dev:desktop",
    "build": "bun run --cwd opencode/packages/desktop build",
    "desktop:build": "bun run --cwd opencode/packages/desktop package:win",
    "typecheck": "bun run --cwd opencode/packages/desktop typecheck",
    "lint": "bun run --cwd opencode lint",
    "test": "bun test --cwd opencode/packages/desktop",
    "legacy:dev": "corepack pnpm --filter @second-brain-os/app dev",
    "legacy:desktop:dev": "corepack pnpm --filter @second-brain-os/app tauri dev",
    "legacy:build": "corepack pnpm --filter @second-brain-os/app build",
    "legacy:test": "corepack pnpm --filter @second-brain-os/app test && cargo test --workspace"
  },
  "workspaces": [
    "app"
  ],
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
